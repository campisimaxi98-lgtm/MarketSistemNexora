{
  "name": "marketsistemnexora",
  "version": "1.0.0",
  "description": "MarketSistemNexora - Sistema de gestion para minimercado / drugstore",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win --dir"
  },
  "author": "Maximiliano Campisi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/campisimaxi98-lgtm/MarketSistemNexora.git"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.nexora.marketsistemnexora",
    "productName": "MarketSistemNexora",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "public/**/*",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MarketSistemNexora"
    }
  }
}
